# Ongeza muda wa kusubiri (10 dakika kwa request moja)
fetch-timeout=600000

# Jaribu mara 10 kabla ya kukata tamaa
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Pakua packages 4 kwa wakati mmoja (badala ya 16)
network-concurrency=4

# Usiitishe audit (inapunguza requests)
audit=false
fund=false

# Tumia cache zaidi
prefer-offline=false
node-linker=hoisted
shamefully-hoist=true
public-hoist-pattern[]=*
