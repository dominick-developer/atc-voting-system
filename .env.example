# GENERAL
NODE_ENV=development
APP_NAME=ATC Online Voting System
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
VOTING_SERVICE_BASE_URL=http://localhost:4100

# DATABASES
DATABASE_URL_API="postgresql://atc_api:CHANGE_ME@localhost:5432/atc_api?schema=public"
DATABASE_URL_VOTING="postgresql://atc_voting:CHANGE_ME@localhost:5433/atc_voting?schema=public"

# REDIS
REDIS_URL=redis://localhost:6379

# JWT / SESSIONS
JWT_ACCESS_SECRET=change_me_long_random_secret_access
JWT_REFRESH_SECRET=change_me_long_random_secret_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_SECRET=change_me_long_random_session_secret

# OTP (optional)
OTP_ENABLED=false
OTP_PROVIDER=stub
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# SMS (optional)
SMS_ENABLED=false
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=ATC

# EMAIL (deferred)
EMAIL_ENABLED=false

# GEOFENCE
GEOFENCE_RADIUS_METERS=100
GEOFENCE_CENTRE_LAT=-3.366667
GEOFENCE_CENTRE_LNG=36.683333
GEOFENCE_ACCURACY_THRESHOLD_METERS=50

# STORAGE
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atc-voting
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ATC API
ATC_API_ENABLED=false
ATC_API_BASE_URL=
ATC_API_KEY=
ATC_API_TIMEOUT_MS=15000

# CORS / SECURITY
CORS_ORIGINS=http://localhost:3000,http://localhost:4100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
