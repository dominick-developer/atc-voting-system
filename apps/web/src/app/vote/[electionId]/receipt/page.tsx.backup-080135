"use client";

import { Suspense } from "react";
import { useSearchParams, useParams } from "next/navigation";
import Link from "next/link";
import {
  CheckCircle2, LockKeyhole, ArrowRight, Loader2, BarChart3,
} from "lucide-react";
import { DashboardShell } from "@/components/layout/dashboard-shell";
import { STUDENT_NAV } from "@/components/layout/sidebar";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { activeElections } from "@/lib/mock-data";

function ReceiptContent() {
  const params       = useParams();
  const searchParams = useSearchParams();
  const electionId   = (params?.electionId as string) ?? "soateco-2026";
  const receiptId    = searchParams.get("ref") ?? "ATC-E2026-000001";

  const election = activeElections.find((e) => e.id === electionId) ?? activeElections[0];

  return (
    <DashboardShell nav={STUDENT_NAV} subtitle="Student Portal" roleLabel="STUDENT"
      title="Vote submitted" topbarSubtitle="Thank you for voting">
      <div className="mx-auto max-w-xl">
        <Card className="overflow-hidden">
          <div className="bg-gradient-to-br from-emerald to-teal-600 p-8 text-center text-white">
            <div className="mx-auto grid h-20 w-20 place-items-center rounded-full bg-white/20 backdrop-blur">
              <CheckCircle2 className="h-10 w-10 text-white" />
            </div>
            <h2 className="mt-5 text-2xl font-black">Ballot successfully received</h2>
            <p className="mt-2 text-sm text-white/80">
              Your ballot has been securely and anonymously stored.
            </p>
          </div>

          <div className="p-6 sm:p-8">
            <div className="rounded-xl bg-slate-50 p-4 text-sm">
              <div className="flex justify-between border-b border-slate-200 py-2">
                <span className="text-slate-500">Receipt reference</span>
                <span className="font-mono font-bold text-[#10243A]">{receiptId}</span>
              </div>
              <div className="flex justify-between border-b border-slate-200 py-2">
                <span className="text-slate-500">Election</span>
                <span className="font-semibold text-[#10243A]">{election.title}</span>
              </div>
              <div className="flex justify-between border-b border-slate-200 py-2">
                <span className="text-slate-500">Submitted</span>
                <span className="text-[#10243A]">{new Date().toLocaleString()}</span>
              </div>
              <div className="flex items-center justify-between py-2">
                <span className="text-slate-500">Status</span>
                <Badge variant="success">Accepted</Badge>
              </div>
            </div>

            <div className="mt-5 rounded-xl border border-emerald/30 bg-emerald/5 p-4">
              <div className="flex items-start gap-2.5">
                <LockKeyhole className="mt-0.5 h-4 w-4 shrink-0 text-emerald" />
                <p className="text-xs leading-relaxed text-slate-700">
                  <strong className="text-[#10243A]">Your selections remain confidential.</strong>{" "}
                  This receipt confirms your ballot was accepted — it does not reveal who you voted for. Even administrators cannot see your choices.
                </p>
              </div>
            </div>

            <div className="mt-6 flex flex-col gap-2 sm:flex-row">
              <Button asChild variant="outline" className="flex-1">
                <Link href="/dashboard">Back to dashboard</Link>
              </Button>
              <Button asChild variant="orange" className="flex-1">
                <Link href="/results">
                  <BarChart3 className="h-4 w-4" /> View live results
                </Link>
              </Button>
            </div>

            <p className="mt-4 text-center text-[11px] text-slate-500">
              Keep this receipt reference. It is the only proof of your vote.
            </p>
          </div>
        </Card>
      </div>
    </DashboardShell>
  );
}

export default function ReceiptPage() {
  return (
    <Suspense fallback={
      <div className="grid min-h-screen place-items-center bg-canvas">
        <Loader2 className="h-6 w-6 animate-spin text-orange" />
      </div>
    }>
      <ReceiptContent />
    </Suspense>
  );
}