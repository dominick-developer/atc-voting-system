"use client";

import { useParams } from "next/navigation";
import Link from "next/link";
import { useState } from "react";
import {
  Printer, Share2, Copy, ArrowLeft, Vote, ShieldCheck, CheckCircle2,
  Calendar, Check, Loader2, Hash, QrCode, Users,
} from "lucide-react";
import { Button } from "@/components/ui/button";

const STEPS = [
  { n: "01", t: "Open the voting platform", d: "Visit the link or scan the QR code" },
  { n: "02", t: "Enter your admission number", d: "Your official ATC ID" },
  { n: "03", t: "Verify your identity", d: "Answer a quick security question" },
  { n: "04", t: "Cast your ballot", d: "One vote per position — anonymous" },
];

export default function SharePage() {
  const params = useParams();
  const electionId = (params?.electionId as string) ?? "soateco-2026";
  const [copied, setCopied] = useState(false);
  const [sharing, setSharing] = useState(false);

  const siteUrl =
    typeof window !== "undefined"
      ? window.location.origin
      : "https://atc-voting-system.vercel.app";
  const posterUrl = `${siteUrl}/share/${electionId}`;
  const voteUrl   = `${siteUrl}/vote/wizard?electionId=${electionId}`;
  const qrSrc     = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&margin=10&data=${encodeURIComponent(voteUrl)}`;

  async function copyLink() {
    try {
      await navigator.clipboard.writeText(posterUrl);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch {}
  }

  async function webShare() {
    if (!navigator.share) { copyLink(); return; }
    setSharing(true);
    try {
      await navigator.share({
        title: "SOATECO General Election 2026 — ATC Voting",
        text: "Vote in the SOATECO 2026 election at Arusha Technical College. Secure. Anonymous. Auditable.",
        url: posterUrl,
      });
    } catch {}
    setSharing(false);
  }

  return (
    <div className="min-h-screen bg-slate-100 print:bg-white">

      {/* ─── Toolbar (hidden when printing) ─── */}
      <div className="no-print sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-xl shadow-sm">
        <div className="mx-auto flex h-16 max-w-5xl flex-wrap items-center justify-between gap-2 px-4 sm:px-6">
          <Link href="/" className="inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover:text-[#10243A]">
            <ArrowLeft className="h-4 w-4" /> Back
          </Link>
          <div className="flex flex-wrap items-center gap-2">
            <Button onClick={copyLink} variant="outline" className="border-2 border-slate-200">
              {copied
                ? <><Check className="h-4 w-4 text-emerald-600" /> Copied!</>
                : <><Copy className="h-4 w-4" /> Copy link</>}
            </Button>
            <Button onClick={webShare} disabled={sharing} className="bg-[#F47721] text-white hover:bg-[#e6670f]">
              {sharing
                ? <><Loader2 className="h-4 w-4 animate-spin" /> Sharing...</>
                : <><Share2 className="h-4 w-4" /> Share</>}
            </Button>
            <Button onClick={() => window.print()} className="bg-[#10243A] text-white hover:bg-[#1a3a5c]">
              <Printer className="h-4 w-4" /> Download PDF
            </Button>
          </div>
        </div>
      </div>

      {/* ─── A4 Poster preview ─── */}
      <div className="flex justify-center overflow-x-auto px-4 py-8 print:p-0 print:overflow-visible">
        <div className="a4-page relative overflow-hidden rounded-lg shadow-2xl ring-1 ring-slate-200">

          {/* ═══ TOP FLAG STRIPE ═══ */}
          <div className="flex h-4 shrink-0">
            <div className="flex-[4] bg-[#1EB53A]" />
            <div className="flex-[1] bg-[#FCD116]" />
            <div className="flex-[4] bg-black" />
            <div className="flex-[1] bg-[#FCD116]" />
            <div className="flex-[4] bg-[#00A3DD]" />
          </div>

          {/* ═══ HEADER ═══ */}
          <div className="flex h-[28mm] shrink-0 items-center justify-between gap-4 border-b-2 border-[#FCD116] px-8">
            <img
              src="/images/voting-logo.png"
              alt="ATC Voting"
              className="h-[18mm] w-[18mm] rounded-full ring-2 ring-[#FCD116]"
            />
            <div className="flex-1 text-center">
              <p className="text-[8px] font-bold uppercase tracking-[0.32em] text-[#1EB53A]">
                The United Republic of Tanzania
              </p>
              <p className="mt-0.5 text-xl font-black leading-tight text-[#10243A] sm:text-2xl">
                ARUSHA TECHNICAL COLLEGE
              </p>
              <p className="mt-0.5 text-[9px] font-bold uppercase tracking-[0.2em] text-[#F47721]">
                ATC Voting System
              </p>
            </div>
            <img
              src="/images/atc-logo.png"
              alt="Arusha Technical College"
              className="h-[18mm] w-[18mm] rounded-full ring-2 ring-[#FCD116]"
            />
          </div>

          {/* ═══ HERO TITLE ═══ */}
          <div className="relative flex h-[45mm] shrink-0 flex-col items-center justify-center overflow-hidden bg-[#10243A] text-white">
            <div className="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(244,119,33,0.35),transparent_55%),radial-gradient(circle_at_80%_80%,rgba(30,181,58,0.25),transparent_55%),radial-gradient(circle_at_50%_0%,rgba(0,163,221,0.2),transparent_60%)]" />
            <div className="relative text-center">
              <p className="text-[10px] font-bold uppercase tracking-[0.4em] text-[#FCD116]">
                Students Organization · General Election
              </p>
              <h1 className="mt-1 text-5xl font-black leading-none tracking-tight sm:text-6xl">
                SOATECO <span className="text-[#F47721]">2026</span>
              </h1>
              <p className="mt-2 text-sm font-medium text-white/75">
                Your Voice · Your Future · Your College
              </p>
            </div>
          </div>

          {/* ═══ INFO CHIPS ═══ */}
          <div className="flex h-[18mm] shrink-0 items-center justify-center gap-2 border-b border-slate-200 px-4">
            {[
              { icon: Calendar,     text: "21–28 Nov 2026",         color: "#F47721", bg: "rgba(244,119,33,0.10)" },
              { icon: Users,        text: "2 Positions · 4 Candidates", color: "#1EB53A", bg: "rgba(30,181,58,0.10)" },
              { icon: ShieldCheck,  text: "100% Anonymous",         color: "#00A3DD", bg: "rgba(0,163,221,0.10)" },
            ].map((chip) => {
              const Icon = chip.icon;
              return (
                <div key={chip.text} className="flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[10px] font-bold text-[#10243A]"
                     style={{ background: chip.bg }}>
                  <Icon className="h-3 w-3" style={{ color: chip.color }} />
                  {chip.text}
                </div>
              );
            })}
          </div>

          {/* ═══ QR + INSTRUCTIONS ═══ */}
          <div className="flex h-[95mm] shrink-0 gap-5 px-8 py-5">

            {/* QR block */}
            <div className="flex w-[65mm] shrink-0 flex-col items-center justify-center rounded-2xl border-4 border-[#F47721] bg-white p-3 text-center shadow-sm">
              <div className="inline-flex items-center gap-1 rounded-full bg-[#F47721]/10 px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#F47721]">
                <QrCode className="h-3 w-3" /> Scan to vote
              </div>
              <img src={qrSrc} alt="Vote QR code" className="mt-2 h-[42mm] w-[42mm]" />
              <p className="mt-2 text-[9px] font-medium text-slate-500">Open your phone camera</p>
              <p className="mt-1 w-full break-all text-center text-[7px] font-mono leading-tight text-slate-400">
                {voteUrl.replace("https://", "").replace("http://", "")}
              </p>
            </div>

            {/* Instructions */}
            <div className="flex flex-1 flex-col justify-center">
              <div className="mb-2 flex items-center gap-2">
                <span className="grid h-8 w-8 place-items-center rounded-lg bg-[#F47721] text-white shadow-md">
                  <Vote className="h-4 w-4" />
                </span>
                <div>
                  <h2 className="text-base font-black uppercase tracking-tight text-[#10243A]">
                    How to Vote
                  </h2>
                  <p className="text-[10px] text-slate-500">In under two minutes</p>
                </div>
              </div>
              <div className="space-y-1.5">
                {STEPS.map((s) => (
                  <div key={s.n} className="flex items-start gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2">
                    <span className="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#10243A] text-[10px] font-black text-white">
                      {s.n}
                    </span>
                    <div className="min-w-0 pt-0.5">
                      <p className="text-[11px] font-bold leading-tight text-[#10243A]">{s.t}</p>
                      <p className="text-[9px] leading-tight text-slate-500">{s.d}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* ═══ SPONSORS ═══ */}
          <div className="flex flex-1 flex-col items-center justify-center border-t-4 border-[#FCD116] bg-gradient-to-b from-slate-50 via-white to-slate-50 px-8 py-3">
            <p className="text-[8px] font-bold uppercase tracking-[0.35em] text-slate-400">
              Sponsored by
            </p>
            <div className="mt-2 flex flex-wrap items-center justify-center gap-6">
              {/* SOATECO */}
              <div className="flex items-center gap-2.5">
                <div className="relative grid h-11 w-11 place-items-center rounded-full bg-white ring-2 ring-[#1EB53A]">
                  <span className="text-[9px] font-black text-[#1EB53A]">SOA</span>
                </div>
                <div>
                  <p className="text-sm font-black leading-tight text-[#10243A]">SOATECO</p>
                  <p className="text-[8px] uppercase tracking-widest text-slate-500">
                    Students Organization · ATC
                  </p>
                </div>
              </div>

              <div className="h-8 w-px bg-slate-300" />

              {/* Smart Tanzania */}
              <div className="flex items-center gap-2.5">
                <div className="relative grid h-11 w-11 place-items-center rounded-full bg-white ring-2 ring-[#F47721]">
                  <span className="text-[8px] font-black text-[#F47721]">STT</span>
                </div>
                <div>
                  <p className="text-sm font-black leading-tight text-[#10243A]">Smart Tanzania</p>
                  <p className="text-[8px] uppercase tracking-widest text-slate-500">
                    Technology Group Network Ltd
                  </p>
                </div>
              </div>
            </div>
            <p className="mt-3 inline-flex items-center gap-1 text-[9px] text-slate-400">
              <ShieldCheck className="h-3 w-3 text-[#1EB53A]" />
              Secure · Anonymous · Auditable · Protected by ATC Digital Democracy
            </p>
          </div>

          {/* ═══ BOTTOM FLAG STRIPE ═══ */}
          <div className="flex h-4 shrink-0">
            <div className="flex-[4] bg-[#1EB53A]" />
            <div className="flex-[1] bg-[#FCD116]" />
            <div className="flex-[4] bg-black" />
            <div className="flex-[1] bg-[#FCD116]" />
            <div className="flex-[4] bg-[#00A3DD]" />
          </div>

        </div>
      </div>

      {/* Print helper note */}
      <p className="no-print pb-8 text-center text-xs text-slate-400">
        Tip: click <strong>Download PDF</strong> → in the print dialog choose <strong>Save as PDF</strong> → single A4 page.
      </p>
    </div>
  );
}